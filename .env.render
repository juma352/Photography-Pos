# Render Environment Variables Template
# Copy these values to Render Dashboard → Environment Variables

# Application Settings
APP_NAME="Mawingu Photography"
APP_ENV=production
APP_KEY=base64:YOUR_KEY_HERE  # Generate with: php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=Europe/Berlin
APP_URL=https://photography-portfolio.onrender.com  # Update with your actual URL

# Database Configuration
# These will be auto-populated if using render.yaml Blueprint
# Otherwise, copy from Render MySQL Dashboard → Internal Connection String
DB_CONNECTION=pgsql
DB_HOST=YOUR_DB_HOST  # e.g., dpg-abc123.frankfurt.render.com
DB_PORT=5432
DB_DATABASE=YOUR_DB_NAME  # e.g., photography_portfolio
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# Cache & Session
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Queue
QUEUE_CONNECTION=database

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_STACK=single

# Mail Configuration (Optional - for contact forms)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Additional Settings
BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local

# Optional: Seeding (set to 'true' for first deployment only)
RUN_SEEDERS=false
